# Copy this file to .env and fill in real values. Never commit .env.
#
# IMPORTANT: if you ever change POSTGRES_PASSWORD after the first
# `docker compose up`, Postgres will NOT pick it up -- it only applies
# POSTGRES_PASSWORD when initializing a fresh (empty) data volume. If you
# see "password authentication failed" after changing it, wipe the volume
# and let Postgres re-initialize:
#
#   docker compose down -v
#   docker compose up --build
#
# (This deletes all data in the local dev database -- fine for dev, never
# run `down -v` against a production volume you care about.)

### Postgres ###
DATABASE_URL=db.xkzazgsiluetfomgbzix.supabase.co
# postgresql://postgres:jignasayaan_db_password@db.xkzazgsiluetfomgbzix.supabase.co:5432/postgres
POSTGRES_DB=db.xkzazgsiluetfomgbzix.supabase.co
# postgresql://postgres:jignasayaan_db_password@db.xkzazgsiluetfomgbzix.supabase.co:5432/postgres
POSTGRES_USER=postgres
# Avoid @ : / and other URL-special characters here -- this value is used
# to build DATABASE_URL directly, and special characters would need
# percent-encoding there. Letters, numbers, and - _ . are always safe.
POSTGRES_PASSWORD=jignasayaan_db_password
POSTGRES_PORT=5432

# db.xkzazgsiluetfomgbzix.supabase.co

### Backend API ###
NODE_ENV=production
API_PORT=4000
# NOTE: DATABASE_URL is no longer set here -- docker-compose.yml builds it
# automatically from the POSTGRES_* values above, so there's exactly one
# place the password lives. (If you run the backend outside Docker, export
# DATABASE_URL yourself, e.g. postgresql://user:pass@localhost:5432/jignasayaan)
# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=https://jignasayaan-psi.vercel.app/,http://localhost,https://jignasayaan.example.com
# Long random string used to sign auth session tokens
JWT_SECRET=change_me_to_a_long_random_value

### Frontend ###
# NEXT_PUBLIC_API_BASE_URL=/api
# FRONTEND_PORT=3000

### Nginx ###
NGINX_PORT=80
NGINX_SSL_PORT=443
