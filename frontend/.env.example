# Client-side (browser) calls -- relative path proxied by nginx in Docker,
# or point at your local backend directly for `npm run dev` outside Docker.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-side (RSC/server components) calls -- needs an absolute URL since
# there's no browser to resolve a relative path against. In Docker this is
# set by docker-compose to http://backend:4000/api; for local `npm run dev`
# outside Docker, point it at your local backend:
INTERNAL_API_BASE_URL=http://localhost:4000/api
